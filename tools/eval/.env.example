# Copy to tools/eval/.env (never committed). Real environment variables win over this file.
# The models the three setups call (the tenant's own models; the judge uses the same endpoint by default).
EVAL_BASE_URL=
EVAL_API_KEY=
# openai | anthropic | google | openai_compatible (the rag-service provider names)
EVAL_PROVIDER=openai_compatible
EVAL_MODEL_CHEAP=
EVAL_MODEL_EXPENSIVE=
# Model that grades answers (POST {EVAL_BASE_URL}/chat/completions, temperature 0)
EVAL_JUDGE_MODEL=
# Optional: a different endpoint or key for the judge
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
# Optional prices per 1M tokens, the tenant's own. Both input and output are needed for a tier;
# without them estimated_cost_per_query_usd stays empty.
EVAL_PRICE_CHEAP_INPUT=
EVAL_PRICE_CHEAP_OUTPUT=
EVAL_PRICE_EXPENSIVE_INPUT=
EVAL_PRICE_EXPENSIVE_OUTPUT=
# A wrong answer whose best passage scored at least this is listed as confident and wrong
EVAL_CONFIDENT_TOP_SCORE=0.5
# Tenant name (the `tenant` column of questions.csv) -> tenant id, comma separated
TENANT_IDS=Lumen=<organization id>
# The rag-service and the secret it shares with the API
RAG_URL=http://localhost:8000
INTERNAL_SECRET=
# Optional: EVAL_NOT_FOUND_MESSAGE (default: the rag-service not_found text), EVAL_TIMEOUT_SECONDS, EVAL_BACKOFF_RETRIES
