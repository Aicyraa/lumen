{
  "name": "lumen-promo",
  "version": "1.0.0",
  "description": "Lumen product promo — seamless RAG integration and two-tier model routing",
  "scripts": {
    "dev": "remotion studio --port 3100",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts LumenPromo",
    "render": "remotion render src/index.ts LumenPromo out/lumen-promo.mp4",
    "assets": "node scripts/score.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "prerender": "npm run assets",
    "prestill": "npm run assets",
    "lint": "eslint src"
  },
  "repository": {},
  "license": "UNLICENSED",
