# Copy to infra/.env (pnpm env:init). Used by the db scripts (pnpm db:up) and docker compose
# (docker compose --env-file infra/.env up -d db). Never commit infra/.env.
# Password for the local development Postgres superuser
POSTGRES_PASSWORD=
# Supabase connection strings (production database; leave empty until you use it)
DB_DIRECT_CONNECTION=
DB_TRANSACTION_POOLER=
