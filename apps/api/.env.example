# Copy to .env. apps/api reads only this file plus the real environment (real variables win).

# --- Required: the API refuses to start without these ---
# Postgres connection string (same database as the rag-service)
DATABASE_URL=
# Better Auth signing secret (long random string)
BETTER_AUTH_SECRET=
# Public URL of this API, for example http://localhost:3000 (its port is the default PORT)
BETTER_AUTH_URL=
# Origin of the dashboard web app: CORS and the verification-email redirect
DASHBOARD_ORIGIN=
# Shared with apps/rag-service/.env (must be equal); also guards /dev/*
INTERNAL_SECRET=
# Base URL of the rag-service, for example http://localhost:8000
RAG_SERVICE_URL=
# Exactly 64 hex characters (AES-256-GCM key for tenant model keys; changing it makes stored keys unreadable)
MODEL_KEY_ENCRYPTION_SECRET=
# Limits (rule 9: never hard-coded)
MAX_DOCUMENTS_PER_TENANT=
RATE_LIMIT_PER_MINUTE=
MAX_REQUESTS_PER_MONTH=
MAX_PROJECTS_PER_USER=

# development, test or production. Anything else is treated as production, and an unset value refuses to start.
# development mounts /dev/* routes and allows http://localhost model endpoints; production also requires SMTP_URL and MAIL_FROM
NODE_ENV=

# --- Optional ---
# Listen port (default: the port of BETTER_AUTH_URL, else 3000)
PORT=
# nodemailer URL, for example smtps://user:pass@smtp.example.com:465 (empty in development logs the link instead)
SMTP_URL=
# Sender address, for example Lumen <no-reply@example.com>
MAIL_FROM=
# Reverse-proxy hops or trusted list for X-Forwarded-For; empty = ignore it
TRUST_PROXY=
# Social sign-in is skipped while its id/secret are empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any key in config.json can be overridden by its UPPER_SNAKE name, for example INGEST_TIMEOUT_MS=
# Models a project may add to each tier (cheap, expensive); default 5 (config.json)
# MAX_MODELS_PER_TIER=
# Test & save attempts per project per minute (each calls the model provider); default 10
# MODEL_TEST_RATE_PER_MINUTE=
# Uploads a project may start per minute, /v1 and dashboard together (429 upload_rate_limited); default 20
# UPLOAD_RATE_PER_MINUTE=
# Documents of one project ingested at once (429 ingest_limit); default 3
# MAX_CONCURRENT_INGESTS=
# Retry-After sent with ingest_limit, in seconds; default 10
# INGEST_LIMIT_RETRY_AFTER_SECONDS=
# When the rag-service answers 503 busy to an ingest: retries (default 3), first wait and longest wait in ms (default 2000, 30000)
# INGEST_BUSY_RETRIES=
# INGEST_BUSY_BACKOFF_MS=
# INGEST_BUSY_BACKOFF_MAX_MS=
