# Vite reads env files only from apps/web (not the repo-root .env), and only VITE_ variables reach the browser.
# Optional in development: it defaults to http://localhost:3000. Required for a production build.
# Copy to apps/web/.env to change it.
# VITE_API_URL=/ means "the page's own origin": the host proxies /api and /v1 to the API (Vercel rewrites in vercel.json).
VITE_API_URL=http://localhost:3000
