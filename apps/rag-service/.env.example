# Copy to .env and fill in. This app reads only this file plus the real environment.
# Postgres connection string (the tests derive lumen_test from it)
DATABASE_URL=
# Shared secret Express sends in X-Internal-Secret; must equal apps/api/.env INTERNAL_SECRET
INTERNAL_SECRET=
# Required. development or test allows the LLM_* default model and http://localhost endpoints; anything else (including empty) is production
NODE_ENV=
# Port for `python -m app.cli dev` and `serve` (default 8000)
RAG_PORT=
# Optional: bind address for `serve` (default 127.0.0.1) and its worker count (default 1)
RAG_HOST=
RAG_WORKERS=
# Optional: DEBUG, INFO (default), WARNING or ERROR for the lumen.rag log lines
LOG_LEVEL=
# Optional: test database URL (default: DATABASE_URL with the database name lumen_test)
TEST_DATABASE_URL=
# Dev/test default model endpoint, used only when a request carries no tenant models
LLM_BASE_URL=
# API key for the dev/test default model
LLM_API_KEY=
# Dev/test default model id for the cheap tier
LLM_MODEL_CHEAP=
# Dev/test default model id for the expensive tier
LLM_MODEL_EXPENSIVE=
