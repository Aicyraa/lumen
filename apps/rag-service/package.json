{
  "name": "@lumen/rag-service",
  "private": true,
  "scripts": {
    "bootstrap": "python -m venv .venv && .venv/bin/pip install -e \".[dev]\" && .venv/bin/python -m app.cli download-models",
    "build": ".venv/bin/python -m app.cli download-models",
    "dev": ".venv/bin/python -m app.cli dev",
    "test": ".venv/bin/python -m app.cli test",
    "typecheck": ".venv/bin/ruff check . && .venv/bin/python -m compileall -q app tests",
    "lint": ".venv/bin/python -m app.cli lint",
    "format": ".venv/bin/python -m app.cli format",
    "check-env": ".venv/bin/python -m app.cli check-env",
    "clean": "rm -rf .pytest_cache .ruff_cache build *.egg-info && find app tests -name __pycache__ -type d -prune -exec rm -rf {} +"
  }
}
